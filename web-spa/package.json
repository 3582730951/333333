{
  "name": "pool-admin-spa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run check:vendor-assets && npm run check:ui-inventory && npm run check:pool-ui-migration && npm run check:spa-routes && npm run check:runtime && npm run check:route-prefetch && npm run check:workflow-contracts && npm run check:registration-pool-surface && npm run check:egress-wizard && npm run check:import-egress && npm run check:ui-regressions && npm run check:visual-smoke && npm run check:codex-reauth-ui && npm run check:upstream-error-rules",
    "verify": "npm run check && npm run typecheck && npm test && npm run build",
    "check:vendor-assets": "node scripts/check-vendor-assets.mjs",
    "check:ui-inventory": "node scripts/check-ui-inventory.mjs",
    "check:pool-ui-migration": "node scripts/check-pool-ui-migration.mjs",
    "check:spa-routes": "node scripts/check-spa-routes.mjs",
    "check:runtime": "node scripts/check-runtime-boundaries.mjs",
    "check:route-prefetch": "node scripts/check-route-prefetch-errors.mjs",
    "check:workflow-contracts": "node scripts/check-workflow-contracts.mjs",
    "check:registration-pool-surface": "node scripts/check-registration-pool-surface.mjs",
    "check:egress-wizard": "node scripts/check-egress-wizard-contracts.mjs",
    "check:import-egress": "node scripts/check-import-egress-contracts.mjs",
    "check:ui-regressions": "node scripts/check-ui-regression-contracts.mjs",
    "check:visual-smoke": "node scripts/check-visual-smoke.mjs",
    "capture:ui-review": "node scripts/capture-ui-review.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "check:upstream-error-rules": "node scripts/check-upstream-error-rules.mjs",
    "check:codex-reauth-ui": "node scripts/check-codex-reauth-ui.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-avatar": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.3.6",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-toast": "^1.2.18",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.7.7",
    "lucide-react": "^1.23.0",
    "puppeteer": "^25.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "recharts": "^3.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "immutable": "5.1.9",
    "postcss": "8.5.24"
  }
}
