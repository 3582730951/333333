+}
+
+.pool-cache-model {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  min-width: 0;
+}
+
+.pool-cache-model > span:last-child {
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* Dashboard hierarchy: compact command surface, two-column mobile KPIs, and balanced chart grids. */
+.pool-dashboard-command {
+  align-items: start;
+  margin-bottom: 18px;
+}
+
+.pool-dashboard-command__main {
+  background:
+    radial-gradient(circle at 92% 8%, color-mix(in srgb, var(--pool-accent) 10%, transparent), transparent 42%),
+    color-mix(in srgb, var(--pool-bg-surface) 96%, transparent);
+}
+
+.pool-dashboard-command__metric strong {
+  font-variant-numeric: tabular-nums;
+  letter-spacing: -0.045em;
+}
+
+.pool-dashboard-command__subgrid div {
+  border-color: color-mix(in srgb, var(--pool-border) 72%, transparent);
+  background: color-mix(in srgb, var(--pool-bg-surface-2) 80%, transparent);
+}
+
+.pool-dashboard-command__side {
+  gap: 10px;
+}
+
+.pool-dashboard-command__side .pool-attention-list {
+  gap: 6px;
+}
+
+.pool-dashboard-command__side .pool-attention-list div {
+  padding: 8px 10px;
+  border-color: color-mix(in srgb, var(--pool-border) 72%, transparent);
+  background: transparent;
+}
+
+.pool-dashboard-command__side .pool-attention-list .pool-attention-item--issue {
+  border-color: color-mix(in srgb, var(--pool-danger) 26%, var(--pool-border));
+  background: color-mix(in srgb, var(--pool-danger-soft) 56%, transparent);
+}
+
+.pool-dashboard-command__side .pool-attention-list .pool-attention-item--clear {
+  border-color: color-mix(in srgb, var(--pool-success) 18%, var(--pool-border));
+}
+
+.pool-quick-actions {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-width: 0;
+  margin-bottom: 18px;
+}
+
+.pool-quick-actions__label {
+  flex: 0 0 auto;
+  margin-right: 2px;
+  color: var(--pool-text-2);
+  font-size: 12px;
+  font-weight: 650;
+}
+
+.pool-dashboard-trend,
+.pool-dashboard-chart-grid {
+  margin-bottom: 18px;
+}
+
+.pool-dashboard-trend__canvas {
+  height: 280px;
+}
+
+.pool-dashboard-chart-grid {
+  align-items: stretch;
+}
+
+.pool-dashboard-chart-grid > .pool-chart-card {
+  min-width: 0;
+  overflow: hidden;
+}
+
+@media (min-width: 768px) and (max-width: 1100px) {
+  .pool-dashboard-chart-grid.pool-grid.cols-3 {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 767px) {
+  .pool-account-quota--compact {
+    width: 100%;
+  }
+
+  .pool-account-quota--compact .pool-account-quota__head {
+    max-width: 280px;
+  }
+
+  .pool-dashboard-command__subgrid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 8px;
+  }
+
+  .pool-dashboard-command__subgrid div {
+    min-height: 70px;
+  }
+
+  .pool-quick-actions {
+    width: 100%;
+    overflow-x: auto;
+    padding: 1px 1px 7px;
+    scrollbar-width: thin;
+    overscroll-behavior-inline: contain;
+    -webkit-overflow-scrolling: touch;
+  }
+
+  .pool-quick-actions > * {
+    flex: 0 0 auto;
+  }
+
+  .pool-dashboard-trend__canvas,
+  .pool-dashboard-trend .pool-chart-frame {
+    height: 238px !important;
+  }
+
+  .pool-dashboard-chart-grid.pool-grid.cols-3 {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .pool-chart-card {
+    overflow: hidden;
+  }
+
+  .pool-chart-legend {
+    justify-content: flex-start;
+    padding-inline: 2px;
+  }
+
+  .pool-chart-legend li > b {
+    max-width: 118px;
+  }
+}
diff --git a/web-spa/tests/accounts-dashboard-presentation.test.ts b/web-spa/tests/accounts-dashboard-presentation.test.ts
