+  margin-bottom: 12px;
+  color: var(--pool-text-2);
+  line-height: 1.55;
+}
+
+.pool-email-import-help code {
+  display: inline-block;
+  max-width: 100%;
+  margin-top: 5px;
+  overflow-wrap: anywhere;
+  color: var(--pool-text);
+}
+
+.pool-email-import-textarea {
+  width: 100%;
+  min-height: 196px;
+  resize: vertical;
+  font-family: var(--pool-font-mono);
+}
+
+.pool-email-modal-actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: 8px;
+  margin-top: 16px;
+}
+
+@media (max-width: 1080px) {
+  .pool-email-metrics {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 767px) {
+  .pool-email-toolbar {
+    width: 100%;
+    overflow-x: auto;
+    padding: 8px;
+    border-radius: var(--pool-radius-lg);
+    scrollbar-width: thin;
+    overscroll-behavior-inline: contain;
+    -webkit-overflow-scrolling: touch;
+  }
+
+  .pool-email-toolbar > * {
+    flex: 0 0 auto;
+  }
+
+  .pool-email-search {
+    width: min(68vw, 280px);
+  }
+
+  .pool-email-metrics {
+    grid-template-columns: none;
+    grid-auto-flow: column;
+    grid-auto-columns: minmax(136px, 1fr);
+    overflow-x: auto;
+    padding: 1px 1px 7px;
+  }
+
+  .pool-email-metrics .pool-metric-card {
+    min-height: 82px;
+    padding: 12px 14px;
+  }
+
+  .pool-email-table .pool-mobile-row {
+    align-items: start;
+  }
+
+  .pool-email-table .pool-mobile-row__actions {
+    grid-column: 1 / -1;
+    width: 100%;
+    justify-content: flex-end;
+    margin-top: -2px;
+  }
+
+  .pool-email-table .pool-email-row-actions {
+    width: 100%;
+    justify-content: flex-end;
+  }
+}
