+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	body := []byte(`{"model":"gpt","previous_response_id":"legacy-exact-response","input":"continue"}`)
+	request, _ := http.NewRequest(http.MethodPost, "/v1/responses", bytes.NewReader(body))
