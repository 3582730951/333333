+	h := newHarness(t, func(w http.ResponseWriter, r *http.Request) {})
+	fallback := storage.UserGroup{
+		ID:      "ug_api_fallback",
+		Name:    "api-fallback",
+		Targets: []storage.TargetRef{{Kind: storage.TargetKindAccountPoolGroup, ID: "cyber"}},
