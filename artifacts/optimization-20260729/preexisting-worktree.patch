+func TestDiagnosticSnapshotCancellationReleasesSQLiteWAL(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "snapshot.sqlite3")
+	store, err := Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer store.Close()
+	if err = store.Init(context.Background()); err != nil {
+		t.Fatal(err)
