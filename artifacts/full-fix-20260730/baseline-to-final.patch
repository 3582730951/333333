+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := part.Write(raw); err != nil {
+		t.Fatal(err)
+	}
+	if err := writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+	req, err := http.NewRequest(http.MethodPost, h.pool.URL+"/admin/accounts/import-archive", &body)
