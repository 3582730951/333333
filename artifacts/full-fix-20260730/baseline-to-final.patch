+		value, _ := io.ReadAll(r.Body)
+		mu.Lock()
+		calls = append(calls, observed{
+			path:        r.URL.Path,
+			query:       r.URL.RawQuery,
+			method:      r.Method,
+			contentType: r.Header.Get("Content-Type"),
+			auth:        r.Header.Get("Authorization"),
+			body:        string(value),
+		})
