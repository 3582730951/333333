+			markModuleStopped(opts.Name)
+			return
+		}
+		if uptime >= opts.ResetAfter {
+			backoff = opts.InitialBackoff
+		} else {
+			backoff = nextBackoff(backoff, opts.MaxBackoff)
+		}
+	}
+}
