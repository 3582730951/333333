+func TestCodexHostedToolPassthroughPreservesPathQueryAuthAndMultipartBoundary(t *testing.T) {
+	type observed struct {
+		path        string
+		query       string
+		method      string
+		contentType string
+		auth        string
+		body        string
+	}
+	var mu sync.Mutex
