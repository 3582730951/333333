+		}
+		_, _ = w.Write([]byte(`{"id":"file_pool_bound","status":"ready"}`))
+	})
+	h.importAccount(t, "codex-resource-a", "upstream-a", "access-codex-resource-a")
+	h.importAccount(t, "codex-resource-b", "upstream-b", "access-codex-resource-b")
