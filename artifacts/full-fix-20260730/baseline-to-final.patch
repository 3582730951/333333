+func TestAccountBackupConflictingPortableDefinitionsRejectZIPAtomically(t *testing.T) {
+	tests := []struct {
+		name         string
+		mutateSecond func(*storage.CustomProvider, *storage.EgressProfile)
+	}{
+		{
+			name: "custom provider",
