       SERVICE_WAS_ACTIVE=1
+      STOP_TIMEOUT_HINT=$(systemctl show "$SERVICE_NAME" \
+        --property=TimeoutStopUSec --value 2>/dev/null || true)
+      systemctl stop --no-block "$SERVICE_NAME"
+      STOP_STARTED=$SECONDS
+      LAST_PROGRESS_SECOND=-5
+      while :; do
+        SERVICE_STATE=$(systemctl show "$SERVICE_NAME" \
+          --property=ActiveState --value 2>/dev/null || true)
+        case "$SERVICE_STATE" in
+          inactive) break ;;
+          failed)
+            die "service entered failed state while draining; cleanup was not started and restart has been requested"
+            ;;
+        esac
+        SERVICE_SUBSTATE=$(systemctl show "$SERVICE_NAME" \
+          --property=SubState --value 2>/dev/null || true)
+        STOP_ELAPSED=$((SECONDS - STOP_STARTED))
+        if ((STOP_ELAPSED - LAST_PROGRESS_SECOND >= 5)); then
+          note "Waiting for in-flight requests to drain: ${STOP_ELAPSED}s (state=${SERVICE_STATE:-unknown}/${SERVICE_SUBSTATE:-unknown}, systemd limit=${STOP_TIMEOUT_HINT:-unknown})"
+          LAST_PROGRESS_SECOND=$STOP_ELAPSED
+        fi
+        ((STOP_ELAPSED < 360)) ||
+          die "service drain exceeded 360s; cleanup was not started and restart has been requested"
+        sleep 1
+      done
+      note "Service stopped cleanly after $((SECONDS - STOP_STARTED))s; starting verified reclamation."
     else
