+func TestEngineRetryBackoffPreservesAttemptBudget(t *testing.T) {
+	store, _ := newTeamFlowFixture(t, false)
+	adapter := &fixtureAdapter{credentialAvailable: true, quota: []int{100}, failInvite: 2}
