+		ID:              "workspace-fixture",
+		Name:            "Lifecycle fixture",
+		ParentAccountID: "parent-account-ref",
+		WorkspaceRef:    "workspace-remote-ref",
+		ConnectorKind:   "fixture",
+		MaxMembers:      8,
+		Status:          TeamWorkspaceStatusActive,
+	})
+	if err != nil {
