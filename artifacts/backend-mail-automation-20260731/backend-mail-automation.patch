+}
+
+.pool-cf-mail-profile__actions {
+  margin-top: auto;
+}
+
+.pool-cf-mail-empty {
+  display: grid;
+  place-items: center;
+  min-height: 248px;
+  padding: 26px;
+  border: 1px dashed color-mix(in srgb, var(--pool-accent) 30%, var(--pool-border));
