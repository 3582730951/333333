+  color: var(--pool-text-3);
+  font-size: 10px;
+}
+
+.pool-cf-mail-profile__meta strong {
+  overflow: hidden;
+  color: var(--pool-text);
+  font-size: 12px;
+  font-variant-numeric: tabular-nums;
