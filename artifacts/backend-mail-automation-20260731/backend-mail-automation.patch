+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .pool-cf-mail-layout {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+@media (max-width: 767px) {
+  .pool-cf-mail-hero {
+    grid-template-columns: minmax(0, 1fr);
+    gap: 20px;
+    padding: 23px 18px;
+    border-radius: 22px;
+  }
+
+  .pool-cf-mail-domain-preview {
+    min-height: 120px;
+    padding: 20px;
+  }
+
+  .pool-cf-mail-metrics {
+    grid-auto-flow: column;
+    grid-auto-columns: minmax(150px, 1fr);
+    grid-template-columns: none;
+    overflow-x: auto;
+    padding: 1px 1px 7px;
+    scrollbar-width: thin;
+  }
+
+  .pool-cf-mail-setup,
+  .pool-cf-mail-guide,
