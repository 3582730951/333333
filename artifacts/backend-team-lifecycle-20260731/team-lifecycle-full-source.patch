+          .filter(Boolean)
+          .some((value) => String(value).toLocaleLowerCase().includes(normalized))
+      ));
+      return [category, visible] as [string, ConfigField[]];
+    })
+    .filter(([, categoryFields]) => categoryFields.length > 0);
+}
