[Unit]
Description=Codex Pool stable public HTTP handoff
After=network-online.target codex-pool.socket
Wants=network-online.target
Requires=codex-pool.socket

[Service]
Type=simple
Sockets=codex-pool.socket
User=codex-pool
Group=codex-pool
WorkingDirectory=/var/lib/codex-pool
ExecStart=/usr/local/bin/codex-pool-handoff --listen 0.0.0.0:8787 --backend-link /var/lib/codex-pool/run/active-worker.sock --control-socket /var/lib/codex-pool/run/handoff-control.sock --pause-state /var/lib/codex-pool/run/admission-paused.json
Restart=always
RestartSec=3
TimeoutStopSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codex-pool
MemoryAccounting=true

[Install]
WantedBy=multi-user.target
