+	}
+	response.Body.Close()
+	raw := <-rawRequest
+	fields := []string{
+		"Accept: application/json\r\n",
+		"Content-Type: application/json\r\n",
+		"User-Agent: claude-cli/2.1.226 (external, sdk-cli)\r\n",
+		"X-Stainless-OS: Linux\r\n",
+		"anthropic-version: 2023-06-01\r\n",
