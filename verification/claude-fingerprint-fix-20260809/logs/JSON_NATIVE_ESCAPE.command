python3 -c 'from pathlib import Path; raw=Path(".run/claude-json-escape-capture/nonroot/request-01.raw").read_bytes(); body=raw.partition(b"\r\n\r\n")[2]; print("native_contains_literal_session="+str(b"<session>" in body).lower()); print("native_contains_literal_tag_amp="+str(b"<tag>&" in body).lower()); print("native_contains_go_html_escape="+str(any(v in body for v in (b"\\u003c",b"\\u003e",b"\\u0026"))).lower())'
