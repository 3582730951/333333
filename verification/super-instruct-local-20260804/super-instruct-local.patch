+func truncateUTF8StartBytes(value string, limit int) string {
+	if limit <= 0 {
+		return ""
+	}
+	var out strings.Builder
+	for index, r := range value {
+		if index >= limit {
+			break
+		}
+		out.WriteRune(r)
+	}
+	return out.String()
+}
