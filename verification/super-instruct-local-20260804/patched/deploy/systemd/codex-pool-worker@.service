[Unit]
Description=Codex Pool worker release %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codex-pool
Group=codex-pool
WorkingDirectory=/var/lib/codex-pool
Environment=CODEX_POOL_DATABASE=/var/lib/codex-pool/pool.sqlite3
Environment=CODEX_POOL_DATA_DIR=/var/lib/codex-pool/data
Environment=CODEX_POOL_SUPER_INSTRUCT_DIR=/usr/local/lib/codex-pool/releases/%i/super-instruct/codex-skills
Environment=CODEX_POOL_SUPER_INSTRUCT_BRIDGE_FILE=/usr/local/lib/codex-pool/releases/%i/super-instruct/bridge.md
Environment=CODEX_POOL_RELEASE_ID=%i
Environment=CODEX_POOL_INSTANCE_ID=%i
Environment=CODEX_REG_NODE_DIR=/usr/local/lib/codex-pool/releases/%i/registrar-node
Environment=CODEX_REG_PYTHON=/usr/local/lib/codex-pool/releases/%i/registrar-python-venv/bin/python
Environment=CODEX_REG_PROTOCOL_SCRIPT=/usr/local/lib/codex-pool/releases/%i/registrar-python/protocol_register.py
Environment=CODEX_REG_SCRIPT=/usr/local/lib/codex-pool/releases/%i/registrar-python/browser_register.py
Environment=CODEX_REG_V3_SCRIPT=/usr/local/lib/codex-pool/releases/%i/registrar-python/reg_v3.py
LoadCredential=master.key:/var/lib/codex-pool/data/keys/master.key
LoadCredential=identity.key:/var/lib/codex-pool/data/keys/identity.key
LoadCredential=diagnostic-alias.key:/var/lib/codex-pool/data/keys/diagnostic-alias.key
ExecStart=/usr/local/lib/codex-pool/releases/%i/codex-pool-server --config /etc/codex-pool/config.json --release-id %i --deployment-role auto --unix-socket /var/lib/codex-pool/run/worker-%i.sock
Restart=on-failure
RestartSec=3
TimeoutStopSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codex-pool
MemoryAccounting=true

[Install]
WantedBy=multi-user.target
