{
  "server": {
    "port": 8787,
    "host": "0.0.0.0",
    "shutdown_drain_seconds": 30
  },
  "database": {
    "path": "./pool.db"
  },
  "lifecycle": {
    "enabled": false,
    "max_concurrency": 3,
    "retry_enabled": true,
    "retry_max_attempts": 3,
    "idle_timeout_seconds": 300,
    "registration_service": {
      "enabled": false,
      "port": 8801,
      "host": "127.0.0.1",
      "health_url": "http://127.0.0.1:8801/health",
      "start_command": "./services/chatgpt_register/start.sh"
    },
    "payment_service": {
      "enabled": false,
      "port": 8802,
      "host": "127.0.0.1",
      "health_url": "http://127.0.0.1:8802/health",
      "start_command": "./services/plus_payment/start.sh"
    }
  },
  "proxy": {
    "enabled": false,
    "default_timeout_seconds": 30
  },
  "fingerprint": {
    "enabled": false,
    "default_mode": "per_account"
  }
}
