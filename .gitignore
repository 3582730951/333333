# Runtime state and local logs
.run/
.gstack/
.agents/
.codex/
.claude/
.build/
*.log

# Repository-local runtime state: configs, databases, credentials, and scratch.
/var/

# Local databases and WAL/SHM sidecars
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Local secrets and machine-specific config
passwd.txt
*.secrets
*.secret
*.env
.env
.env.*
config.local*.json
config.test*.json
config.*.json
!config.example.json
!config.lifecycle.json

# Build outputs and dependencies
node_modules/
web-spa/node_modules/
web-spa/dist/
/bin/
/pool-server
/pool-server-new
/other_cpa
/pool_server
/pool_server_test
/codex-pool
/cmd/pool-server/pool-server
/wsl-list.txt
/other_new_gpt_register
/other
/example_zip

# Local-only reference repositories and diagnostic fixtures. These may contain
# nested Git histories, credentials, or production-derived captures.
/third_party/reference/
/data/
/diagnostics/

# GitHub source-publication policy. The only published documentation file is
# the root README.md; tests remain available in the local/internal worktree but
# are deliberately absent from the GitHub branch.
/archive/
/artifacts/
/docs/
/tests/
**/tests/
**/testdata/
*_test.*
test_*.*
test-*.*
*-test.*
*.test.*
*_spec.*
spec_*.*
spec-*.*
*-spec.*
*.spec.*
*selftest*
playwright.config.*
vitest.config.*
jest.config.*
/scripts/ci.sh
/cmd/extreme-load/
/tools/acceptance/
/tools/e2e/
/tools/visual/

# P0 implementation coverage must remain in version control and CI. Keep the
# broader local-test policy unchanged for every other test path.
!internal/api/force_codex_429_test.go
!internal/api/force_codex_429_synthetic_test.go
!internal/api/codex_thread_admin_test.go
!internal/api/codex_rollover_identity_test.go
!internal/api/entitlement_capture_test.go
!internal/api/quota_premium_window_test.go
!internal/api/client_identity_context_test.go
!internal/clientidentity/client_identity_test.go
!internal/entitlement/entitlement_test.go
!internal/refusaldetect/detector_test.go
!internal/storage/account_request_rate_v2_test.go
!internal/storage/codex_429_confirmation_test.go
!internal/storage/codex_session_rollover_claim_test.go
!internal/upstream/force_codex_429_test.go
!web-spa/tests/
web-spa/tests/*
!web-spa/tests/capacity-contract.test.ts
!web-spa/tests/class-drift-jsx.test.ts
!web-spa/tests/pool-nav.test.tsx
!web-spa/tests/fixtures/
!web-spa/tests/fixtures/class-drift/
!web-spa/tests/fixtures/class-drift/*.tsx

# Python caches and captured traffic artifacts
__pycache__/
*.pyc
*.pcap
*.pcapng
capture/out*/
auth.json

# Generated screenshots / visual inspection artifacts
pngs/
pngs_s/
screenshot*.png

# Keep the embedded console bundle tracked for the Go binary.
!internal/console/dist/
!internal/console/dist/**

# Documentation policy is last so a broader build-artifact exception cannot
# accidentally re-include nested Markdown. Only the root README is published.
*.md
!/README.md
